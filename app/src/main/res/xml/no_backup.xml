<?xml version="1.0" encoding="utf-8"?>
<!-- keys live in app storage; never back them up or transfer them -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /><exclude domain="sharedpref" path="." /><exclude domain="file" path="." /></cloud-backup>
    <device-transfer><exclude domain="root" path="." /><exclude domain="sharedpref" path="." /><exclude domain="file" path="." /></device-transfer>
</data-extraction-rules>
